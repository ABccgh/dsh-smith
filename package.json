{
  "name": "dsh-smith",
  "version": "0.3.0",
  "description": "Four DeepSeek Harness agent presets: `dsh-smith`, which builds harness agents and Cordis plugins, `dsh-forge`, a software-delivery agent, `dsh-ck3-mod`, a Crusader Kings III mod-authoring agent with a check-before-delivery gate, and `dsh-duanju`, a vertical short-drama production line whose script stage is gated by the user's own evaluation on the 有戏AI platform. Each carries a thinking protocol, a layered memory discipline, and a standing team of named experts.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "agent-preset",
    "cordis",
    "plugin",
    "multi-agent",
    "expert-team",
    "software-development",
    "crusader-kings-3",
    "short-drama",
    "vertical-video"
  ],
  "license": "MIT",
  "author": "ABccgh",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "dsh-smith",
    "dsh-forge",
    "dsh-ck3-mod",
    "dsh-duanju",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "dsh-preset-install": "bin/install.mjs",
    "dsh-preset-verify": "bin/verify.mjs",
    "dsh-preset-lint-skills": "bin/lint-skills.mjs",
    "dsh-preset-drift-check": "bin/drift-check.mjs",
    "dsh-preset-preflight": "bin/preflight.mjs"
  },
  "scripts": {
    "install-preset": "node bin/install.mjs",
    "install-forge": "node bin/install.mjs --preset dsh-forge",
    "verify": "node bin/verify.mjs",
    "verify-forge": "node bin/verify.mjs --preset dsh-forge",
    "lint": "node bin/lint-skills.mjs",
    "lint-forge": "node bin/lint-skills.mjs --preset dsh-forge",
    "preflight": "node bin/preflight.mjs",
    "preflight-forge": "node bin/preflight.mjs --preset dsh-forge",
    "drift": "node bin/drift-check.mjs",
    "drift-forge": "node bin/drift-check.mjs --preset dsh-forge",
    "pack-check": "node bin/check-pack.mjs",
    "check": "node bin/lint-skills.mjs && node bin/preflight.mjs && node bin/verify.mjs",
    "check:all": "node bin/lint-skills.mjs && node bin/preflight.mjs && node bin/lint-skills.mjs --preset dsh-forge && node bin/preflight.mjs --preset dsh-forge"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ABccgh/dsh-smith.git"
  },
  "homepage": "https://github.com/ABccgh/dsh-smith#readme",
  "bugs": {
    "url": "https://github.com/ABccgh/dsh-smith/issues"
  },
  "dsh": {
    "presets": [
      {
        "id": "dsh-smith",
        "repoDir": "dsh-smith",
        "installTarget": "${DSH_HOME:-~/.dsh}/.agent-presets/dsh-smith"
      },
      {
        "id": "dsh-forge",
        "repoDir": "dsh-forge",
        "installTarget": "${DSH_HOME:-~/.dsh}/.agent-presets/dsh-forge"
      },
      {
        "id": "dsh-ck3-mod",
        "repoDir": "dsh-ck3-mod",
        "installTarget": "${DSH_HOME:-~/.dsh}/.agent-presets/dsh-ck3-mod"
      },
      {
        "id": "dsh-duanju",
        "repoDir": "dsh-duanju",
        "installTarget": "${DSH_HOME:-~/.dsh}/.agent-presets/dsh-duanju"
      }
    ]
  },
  "topics": [
    "deepseek-harness-plugins",
    "deepseek-harness",
    "dsh",
    "cordis",
    "agent-preset",
    "preset",
    "expert-team",
    "multi-agent",
    "ai-agent",
    "software-development"
  ]
}
